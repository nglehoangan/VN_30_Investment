        ],
        "sha256": "2afc75a20e13d08b88459f57b39a6ebb13f91452fc8b3313a0e817ea0dd44aff"
      }
    },
    {
      "finding": "Approved formula explicitly uses interest-bearing debt minus unrestricted cash, with normalized EBITDA and consistent lease treatment; bare bank-style debt/equity forbidden.",
      "reference": {
        "path": "docs/03 SCORING/METRIC_DEFINITIONS.md",
        "lines": [
          625,
          665,
          1591,
          1603
