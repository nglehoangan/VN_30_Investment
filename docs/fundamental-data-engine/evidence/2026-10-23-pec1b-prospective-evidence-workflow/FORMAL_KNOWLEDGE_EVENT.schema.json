{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vn30:pec1b:formal-knowledge-event:v1",
  "title": "Future authenticated formal event; NOT generated by PEC-1B preparation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actorId",
    "actorRole",
    "authenticationReference",
    "effectiveAt",
    "eventHash",
    "eventId",
    "eventType",
    "evidenceHash",
    "evidenceReference",
    "knownAt",
    "occurredAt",
    "previousEventHash",
    "recordedAt",
    "sourceEvidenceHash",
    "subjectId",
    "subjectVersion",
    "validationStatus"
  ],
  "properties": {
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "evidenceReference": {
      "type": "string",
      "minLength": 1
    },
    "previousEventHash": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actorRole": {
      "enum": [
        "Data Evidence Reviewer",
        "Data Quality Owner",
        "Dataset Owner",
        "Independent Validator",
        "Investment System Owner",
        "Methodology Owner",
        "Registry Owner"
      ]
    },
    "subjectVersion": {
      "type": "string",
      "minLength": 1
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "validationStatus": {
      "const": "AUTHENTICATED_VALIDATED"
    },
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "enum": [
        "SOURCE_ACQUIRED",
        "SOURCE_VERIFIED",
        "FORMAL_INGESTION_COMPLETED",
        "FINANCIAL_MAPPING_ACCEPTED",
        "METHODOLOGY_APPROVED",
        "REGISTRY_VERSION_APPROVED",
        "SOURCE_CONTRACT_APPROVED",
        "IDENTITY_METHOD_APPROVED",
        "SOURCE_METHOD_APPROVED",
        "IDENTITY_BINDING_APPROVED",
        "INDEPENDENT_VALIDATION_ACCEPTED",
        "DATASET_CUTOFF_APPROVED"
      ]
    },
    "authenticationReference": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "knownAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceEvidenceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actorId": {
      "type": "string",
      "minLength": 1
    }
  },
  "$comment": "Schema validity is necessary only. Authentication, authorization, immutable evidence, exact scope, causal chain, trusted capture clock and revocation must be independently resolved. No authoritative writer/provider is implemented."
}
