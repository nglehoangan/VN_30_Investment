generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/db/generated"
}

datasource db {
  provider = "sqlite"
}

// Append-only broker evidence, separate from approved accounting transactions.
model BrokerObservation {
  id String @id
  kind String
  apiId String? @map("api_id")
  receivedAt String @map("received_at")
  body String
  bodyHash String @map("body_hash")
  @@index([kind, receivedAt])
  @@map("broker_observation")
}

model MethodologyRecord {
  decisionArtifacts DecisionArtifact[]
  analyticalArtifacts AnalyticalArtifact[]
  transactions LedgerTransaction[]
  methodologyId             String @id @map("methodology_id")
  family                    String
  semanticVersion           String @map("semantic_version")
  approvalReference         String @map("approval_reference")
  governanceStatus          String @default("APPROVED") @map("governance_status")
  intendedUse               String @default("PRODUCTION") @map("intended_use")
  effectiveDate             String @map("effective_date")
  configurationReference    String @map("configuration_reference")
  implementationIdentity    String @map("implementation_identity")
  governingDocumentReference String @map("governing_document_reference")
  recordedAt                String @map("recorded_at")

  @@index([family, effectiveDate])
  @@map("methodology_record")
}

model Portfolio {
  id String @id
  name String
  currency String
  inceptionAt String @map("inception_at")
  createdAt String @map("created_at")
  revision String @default("0")
  transactions LedgerTransaction[]
  projection PortfolioProjection?
  @@map("portfolio")
}
model Security {
  fundamentalDerivations FundamentalDerivation[]
  fundamentalNormalizations FundamentalNormalization[]
  fundamentalObservations FundamentalObservation[]
  id String @id
  name String
  transactions LedgerTransaction[]
  legs LedgerLeg[]
  @@map("security")
}
model CorporateActionReference {
  id String @id
  terms String
  transactions LedgerTransaction[]
  @@map("corporate_action_reference")
}
model LedgerTransaction {
  corporateActionId String? @map("corporate_action_id")
  corporateAction CorporateActionReference? @relation(fields: [corporateActionId], references: [id], onDelete: Restrict)
  id String @id
  portfolioId String @map("portfolio_id")
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  securityId String? @map("security_id")
  security Security? @relation(fields: [securityId], references: [id], onDelete: Restrict)
  type String
  status String
  eventAt String @map("event_at")
  createdAt String @map("created_at")
  source String
  sourceReference String @map("source_reference")
  idempotencyKey String @map("idempotency_key")
  methodologyId String @map("methodology_id")
  methodology MethodologyRecord @relation(fields: [methodologyId], references: [methodologyId], onDelete: Restrict)
  revision String
  facts String
  legCount Int @map("leg_count")
  reversesId String? @unique @map("reverses_id")
  reversed LedgerTransaction? @relation("reversal", fields: [reversesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversal LedgerTransaction? @relation("reversal")
  settlesId String? @map("settles_id")
  settled LedgerTransaction? @relation("settlement", fields: [settlesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  settlements LedgerTransaction[] @relation("settlement")
  legs LedgerLeg[]
  @@unique([portfolioId, idempotencyKey])
  @@unique([portfolioId, source, sourceReference])
  @@index([portfolioId, eventAt])
  @@map("ledger_transaction")
}
model LedgerLeg {
  id String @id
  transactionId String @map("transaction_id")
  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  sequence Int
  type String
  effectiveAt String @map("effective_at")
  securityId String? @map("security_id")
  security Security? @relation(fields: [securityId], references: [id], onDelete: Restrict)
  quantity String?
  amount String?
  settlementReference String? @map("settlement_reference")
  obligation LedgerLeg? @relation("obligation", fields: [settlementReference], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clearings LedgerLeg[] @relation("obligation")
  @@unique([transactionId, sequence])
  @@index([effectiveAt])
  @@map("ledger_leg")
}
model PortfolioProjection {
  portfolioId String @id @map("portfolio_id")
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  watermark String
  asOf String @map("as_of")
  calculatedAt String @map("calculated_at")
  payload String
  @@map("portfolio_projection")
}

model AnalyticalArtifact {
  scoringDatasetBinding ScoringDatasetBinding?
  id String @id
  kind String
  methodologyId String @map("methodology_id")
  methodology MethodologyRecord @relation(fields: [methodologyId], references: [methodologyId], onDelete: Restrict, onUpdate: Restrict)
  asOf String @map("as_of")
  calculatedAt String @map("calculated_at")
  body String
  bodyHash String @map("body_hash")
  @@index([asOf])
  @@map("analytical_artifact")
}

model DecisionArtifact {
  methodology MethodologyRecord @relation(fields: [methodologyId], references: [methodologyId], onDelete: Restrict, onUpdate: Restrict)
  prior DecisionArtifact? @relation("decision_lineage", fields: [priorDecisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions DecisionArtifact[] @relation("decision_lineage")
  id String @id
  securityId String @map("security_id")
  methodologyId String @map("methodology_id")
  asOf String @map("as_of")
  recordedAt String @map("recorded_at")
  priorDecisionId String? @map("prior_decision_id")
  body String
  bodyHash String @map("body_hash")
  @@index([securityId, asOf])
  @@map("decision_artifact")
}

model WorkflowReview {
  id String @id
  identityHash String @unique @map("identity_hash")
  portfolioId String @map("portfolio_id")
  type String
  supersedesId String? @map("supersedes_id")
  recordedAt String @map("recorded_at")
  body String
  bodyHash String @map("body_hash")
  proposals WorkflowProposal[]
  audits WorkflowAudit[]
  executions WorkflowExecution[]
  @@index([portfolioId, type])
  @@map("workflow_review")
}
model WorkflowProposal {
  id String @id
  reviewId String @unique @map("review_id")
  review WorkflowReview @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  body String
  bodyHash String @map("body_hash")
  @@map("workflow_proposal")
}
model WorkflowAudit {
  id String @id
  reviewId String @map("review_id")
  review WorkflowReview @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  body String
  bodyHash String @map("body_hash")
  @@map("workflow_audit")
}
model WorkflowExecution {
  id String @id
  reviewId String @map("review_id")
  review WorkflowReview @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactionId String @unique @map("transaction_id")
  body String
  bodyHash String @map("body_hash")
  @@map("workflow_execution")
}

model MarginalAllocation {
  id String @id
  body String
  bodyHash String @map("body_hash")
  @@map("marginal_allocation")
}

// Slice 1 analytical evidence only. No provider, selector, derivation or scoring state.
model FundamentalSourceVersion {
  normalizations FundamentalNormalization[]
  id String @id
  recordedAt String @map("recorded_at")
  body String
  bodyHash String @map("body_hash")
  batches FundamentalImportBatch[]
  captures FundamentalRawCapture[]
  observations FundamentalObservation[]
  @@map("fundamental_source_version")
}
model FundamentalImportBatch {
  normalizations FundamentalNormalization[]
  id String @id
  sourceVersionId String @map("source_version_id")
  source FundamentalSourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  completedAt String @map("completed_at")
  body String
  bodyHash String @map("body_hash")
  captures FundamentalRawCapture[]
  @@unique([id, sourceVersionId])
  @@index([sourceVersionId, completedAt])
  @@map("fundamental_import_batch")
}
model FundamentalRawCapture {
  normalizations FundamentalNormalization[]
  id String @id
  sourceVersionId String @map("source_version_id")
  source FundamentalSourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  importExecutionId String @map("import_execution_id")
  batch FundamentalImportBatch @relation(fields: [importExecutionId, sourceVersionId], references: [id, sourceVersionId], onDelete: Restrict, onUpdate: Restrict)
  retrievedAt String @map("retrieved_at")
  payloadHash String @map("payload_hash")
  body String
  bodyHash String @map("body_hash")
  observations FundamentalObservation[]
  @@unique([id, sourceVersionId])
  @@index([sourceVersionId, retrievedAt])
  @@map("fundamental_raw_capture")
}

model FundamentalNormalization {
  id String @id
  securityId String @map("security_id")
  security Security @relation(fields: [securityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceVersionId String @map("source_version_id")
  source FundamentalSourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  importExecutionId String @map("import_execution_id")
  batch FundamentalImportBatch @relation(fields: [importExecutionId, sourceVersionId], references: [id, sourceVersionId], onDelete: Restrict, onUpdate: Restrict)
  rawCaptureId String @map("raw_capture_id")
  capture FundamentalRawCapture @relation(fields: [rawCaptureId, sourceVersionId], references: [id, sourceVersionId], onDelete: Restrict, onUpdate: Restrict)
  recordedAt String @map("recorded_at")
  status String
  body String
  bodyHash String @map("body_hash")
  @@index([securityId, recordedAt])
  @@map("fundamental_normalization")
}
model FundamentalObservation {
  availabilityAssessments FundamentalAvailabilityAssessment[]
  snapshotMembers FundamentalSnapshotMember[]
  derivationInputs FundamentalDerivationInput[]
  id String @id
  securityId String @map("security_id")
  security Security @relation(fields: [securityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceVersionId String @map("source_version_id")
  source FundamentalSourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rawCaptureId String @map("raw_capture_id")
  capture FundamentalRawCapture @relation(fields: [rawCaptureId, sourceVersionId], references: [id, sourceVersionId], onDelete: Restrict, onUpdate: Restrict)
  itemId String @map("item_id")
  registryHash String @map("registry_hash")
  reportingScope String @map("reporting_scope")
  periodStart String @map("period_start")
  periodEnd String @map("period_end")
  fieldLocator String @map("field_locator")
  mappingVersion String @map("mapping_version")
  ingestedAt String @map("ingested_at")
  normalizedValue String? @map("normalized_value")
  availableAt String? @map("available_at")
  availabilityStatus String @map("availability_status")
  supersedesObservationId String? @map("supersedes_observation_id")
  predecessor FundamentalObservation? @relation("fundamental_revision", fields: [supersedesObservationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  successors FundamentalObservation[] @relation("fundamental_revision")
  body String
  bodyHash String @map("body_hash")
  @@unique([rawCaptureId, itemId, registryHash, reportingScope, periodStart, periodEnd, fieldLocator, mappingVersion])
  @@index([securityId, itemId, reportingScope, periodEnd])
  @@index([sourceVersionId, ingestedAt])
  @@index([supersedesObservationId])
  @@map("fundamental_observation")
}

model FundamentalDerivation {
  snapshotMembers FundamentalSnapshotDerivedMember[]
  id String @id
  securityId String @map("security_id")
  security Security @relation(fields: [securityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recordedAt String @map("recorded_at")
  status String
  body String
  bodyHash String @map("body_hash")
  inputs FundamentalDerivationInput[]
  @@index([securityId, recordedAt])
  @@map("fundamental_derivation")
}
model FundamentalDerivationInput {
  derivationId String @map("derivation_id")
  derivation FundamentalDerivation @relation(fields: [derivationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operand Int
  position Int
  observationId String @map("observation_id")
  observation FundamentalObservation @relation(fields: [observationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@id([derivationId, operand, position])
  @@map("fundamental_derivation_input")
}

model FundamentalAvailabilityAssessment {
  id String @id
  observationId String @map("observation_id")
  observation FundamentalObservation @relation(fields: [observationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  policyVersion String @map("policy_version")
  availableAt String? @map("available_at")
  assessedAt String @map("assessed_at")
  body String
  bodyHash String @map("body_hash")
  members FundamentalSnapshotMember[]
  @@index([observationId, policyVersion])
  @@index([availableAt])
  @@map("fundamental_availability_assessment")
}
model FundamentalSnapshotContent {
  contentHash String @id @map("content_hash")
  manifest String
  manifestDigest String @map("manifest_digest")
  runs FundamentalSnapshotRun[]
  @@map("fundamental_snapshot_content")
}
model FundamentalSnapshotRun {
  diAcceptances DataInitializationAcceptance[]
  scoringBindings ScoringDatasetBinding[]
  runId String @id @map("run_id")
  contentHash String @map("content_hash")
  content FundamentalSnapshotContent @relation(fields: [contentHash], references: [contentHash], onDelete: Restrict, onUpdate: Restrict)
  builtAt String @map("built_at")
  body String
  bodyHash String @map("body_hash")
  members FundamentalSnapshotMember[]
  derivedMembers FundamentalSnapshotDerivedMember[]
  @@index([contentHash, builtAt])
  @@map("fundamental_snapshot_run")
}
model FundamentalSnapshotMember {
  runId String @map("run_id")
  run FundamentalSnapshotRun @relation(fields: [runId], references: [runId], onDelete: Restrict, onUpdate: Restrict)
  observationId String @map("observation_id")
  observation FundamentalObservation @relation(fields: [observationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assessmentId String @map("assessment_id")
  assessment FundamentalAvailabilityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  selected Boolean
  @@id([runId, observationId])
  @@map("fundamental_snapshot_member")
}

model FundamentalSnapshotDerivedMember {
  runId String @map("run_id")
  run FundamentalSnapshotRun @relation(fields: [runId], references: [runId], onDelete: Restrict, onUpdate: Restrict)
  derivationId String @map("derivation_id")
  derivation FundamentalDerivation @relation(fields: [derivationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  selected Boolean
  @@id([runId, derivationId])
  @@map("fundamental_snapshot_derived_member")
}

model DataInitializationAcceptance {
  id String @id
  snapshotRunId String @map("snapshot_run_id")
  snapshotRun FundamentalSnapshotRun @relation(fields: [snapshotRunId], references: [runId], onDelete: Restrict, onUpdate: Restrict)
  acceptedAt String @map("accepted_at")
  body String
  bodyHash String @map("body_hash")
  scoringBindings ScoringDatasetBinding[]
  @@index([snapshotRunId, acceptedAt])
  @@map("data_initialization_acceptance")
}
model ScoringDatasetBinding {
  scorecardId String @id @map("scorecard_id")
  scorecard AnalyticalArtifact @relation(fields: [scorecardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  snapshotRunId String @map("snapshot_run_id")
  snapshotRun FundamentalSnapshotRun @relation(fields: [snapshotRunId], references: [runId], onDelete: Restrict, onUpdate: Restrict)
  acceptanceId String @map("acceptance_id")
  acceptance DataInitializationAcceptance @relation(fields: [acceptanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inputHash String @map("input_hash")
  createdAt String @map("created_at")
  body String
  bodyHash String @map("body_hash")
  @@map("scoring_dataset_binding")
}
