generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/db/generated"
}

datasource db {
  provider = "sqlite"
}

// Append-only broker evidence, separate from approved accounting transactions.
model BrokerObservation {
  id String @id
  kind String
  apiId String? @map("api_id")
  receivedAt String @map("received_at")
  body String
  bodyHash String @map("body_hash")
  @@index([kind, receivedAt])
  @@map("broker_observation")
}

model MethodologyRecord {
  decisionArtifacts DecisionArtifact[]
  analyticalArtifacts AnalyticalArtifact[]
  transactions LedgerTransaction[]
  methodologyId             String @id @map("methodology_id")
  family                    String
  semanticVersion           String @map("semantic_version")
  approvalReference         String @map("approval_reference")
  governanceStatus          String @default("APPROVED") @map("governance_status")
  intendedUse               String @default("PRODUCTION") @map("intended_use")
  effectiveDate             String @map("effective_date")
  configurationReference    String @map("configuration_reference")
  implementationIdentity    String @map("implementation_identity")
  governingDocumentReference String @map("governing_document_reference")
  recordedAt                String @map("recorded_at")

  @@index([family, effectiveDate])
  @@map("methodology_record")
}

model Portfolio {
  id String @id
  name String
  currency String
  inceptionAt String @map("inception_at")
  createdAt String @map("created_at")
  revision String @default("0")
  transactions LedgerTransaction[]
  projection PortfolioProjection?
  @@map("portfolio")
}
model Security {
  id String @id
  name String
  transactions LedgerTransaction[]
  legs LedgerLeg[]
  @@map("security")
}
model CorporateActionReference {
  id String @id
  terms String
  transactions LedgerTransaction[]
  @@map("corporate_action_reference")
}
model LedgerTransaction {
  corporateActionId String? @map("corporate_action_id")
  corporateAction CorporateActionReference? @relation(fields: [corporateActionId], references: [id], onDelete: Restrict)
  id String @id
  portfolioId String @map("portfolio_id")
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  securityId String? @map("security_id")
  security Security? @relation(fields: [securityId], references: [id], onDelete: Restrict)
  type String
  status String
  eventAt String @map("event_at")
  createdAt String @map("created_at")
  source String
  sourceReference String @map("source_reference")
  idempotencyKey String @map("idempotency_key")
  methodologyId String @map("methodology_id")
  methodology MethodologyRecord @relation(fields: [methodologyId], references: [methodologyId], onDelete: Restrict)
  revision String
  facts String
  legCount Int @map("leg_count")
  reversesId String? @unique @map("reverses_id")
  reversed LedgerTransaction? @relation("reversal", fields: [reversesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversal LedgerTransaction? @relation("reversal")
  settlesId String? @map("settles_id")
  settled LedgerTransaction? @relation("settlement", fields: [settlesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  settlements LedgerTransaction[] @relation("settlement")
  legs LedgerLeg[]
  @@unique([portfolioId, idempotencyKey])
  @@unique([portfolioId, source, sourceReference])
  @@index([portfolioId, eventAt])
  @@map("ledger_transaction")
}
model LedgerLeg {
  id String @id
  transactionId String @map("transaction_id")
  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  sequence Int
  type String
  effectiveAt String @map("effective_at")
  securityId String? @map("security_id")
  security Security? @relation(fields: [securityId], references: [id], onDelete: Restrict)
  quantity String?
  amount String?
  settlementReference String? @map("settlement_reference")
  obligation LedgerLeg? @relation("obligation", fields: [settlementReference], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clearings LedgerLeg[] @relation("obligation")
  @@unique([transactionId, sequence])
  @@index([effectiveAt])
  @@map("ledger_leg")
}
model PortfolioProjection {
  portfolioId String @id @map("portfolio_id")
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  watermark String
  asOf String @map("as_of")
  calculatedAt String @map("calculated_at")
  payload String
  @@map("portfolio_projection")
}

model AnalyticalArtifact {
  id String @id
  kind String
  methodologyId String @map("methodology_id")
  methodology MethodologyRecord @relation(fields: [methodologyId], references: [methodologyId], onDelete: Restrict, onUpdate: Restrict)
  asOf String @map("as_of")
  calculatedAt String @map("calculated_at")
  body String
  bodyHash String @map("body_hash")
  @@index([asOf])
  @@map("analytical_artifact")
}

model DecisionArtifact {
  methodology MethodologyRecord @relation(fields: [methodologyId], references: [methodologyId], onDelete: Restrict, onUpdate: Restrict)
  prior DecisionArtifact? @relation("decision_lineage", fields: [priorDecisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions DecisionArtifact[] @relation("decision_lineage")
  id String @id
  securityId String @map("security_id")
  methodologyId String @map("methodology_id")
  asOf String @map("as_of")
  recordedAt String @map("recorded_at")
  priorDecisionId String? @map("prior_decision_id")
  body String
  bodyHash String @map("body_hash")
  @@index([securityId, asOf])
  @@map("decision_artifact")
}

model WorkflowReview {
  id String @id
  identityHash String @unique @map("identity_hash")
  portfolioId String @map("portfolio_id")
  type String
  supersedesId String? @map("supersedes_id")
  recordedAt String @map("recorded_at")
  body String
  bodyHash String @map("body_hash")
  proposals WorkflowProposal[]
  audits WorkflowAudit[]
  executions WorkflowExecution[]
  @@index([portfolioId, type])
  @@map("workflow_review")
}
model WorkflowProposal {
  id String @id
  reviewId String @unique @map("review_id")
  review WorkflowReview @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  body String
  bodyHash String @map("body_hash")
  @@map("workflow_proposal")
}
model WorkflowAudit {
  id String @id
  reviewId String @map("review_id")
  review WorkflowReview @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  body String
  bodyHash String @map("body_hash")
  @@map("workflow_audit")
}
model WorkflowExecution {
  id String @id
  reviewId String @map("review_id")
  review WorkflowReview @relation(fields: [reviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactionId String @unique @map("transaction_id")
  body String
  bodyHash String @map("body_hash")
  @@map("workflow_execution")
}

model MarginalAllocation {
  id String @id
  body String
  bodyHash String @map("body_hash")
  @@map("marginal_allocation")
}
